# Public, build-time values (inlined into the bundle by `next build`). Never put secrets here.
# In production they MUST be set BEFORE `pnpm build`; changing them afterwards has no effect.

# Local development
NEXT_PUBLIC_API_URL=http://127.0.0.1:3011/api/v1
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# Production (set on the VPS only, e.g. in .env.production.local, before building):
# NEXT_PUBLIC_API_URL=https://api.benuuprint.com/api/v1
# NEXT_PUBLIC_SITE_URL=https://benuuprint.com

# Runtime-only (read by `pnpm start` / PM2, not by the browser). Defaults: HOST=0.0.0.0 PORT=3001.
# Production: HOST=127.0.0.1 PORT=3021 (set by ecosystem.config.cjs).
